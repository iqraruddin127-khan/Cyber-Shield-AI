# =============================================================================
# CyberShield AI - Streamlit Cloud Secrets
# =============================================================================
# Copy this file to .streamlit/secrets.toml to test cloud mode locally.
# For Streamlit Cloud deployment, paste these values in:
#   App Settings → Secrets
# =============================================================================

# Enable standalone cloud mode (no FastAPI backend needed)
STANDALONE_MODE = "1"

# Supabase Configuration
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-key"

# DashScope API Key (Qwen AI)
# Get from: https://dashscope.console.aliyun.com/ → API-KEY Management
DASHSCOPE_API_KEY = "your-dashscope-api-key"
